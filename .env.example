# Copy to .env and adjust. Every variable has a default; this file shows them all.

# ===== Service =====
# DEBUG | INFO | WARNING | ERROR (logs go to stdout)
LOG_LEVEL=INFO
# Max size of the uploaded file, MB (bigger -> 413)
MAX_UPLOAD_MB=10
# Photos larger than this (px, longest side) are downscaled before processing: saves RAM and time
MAX_SIDE=2000
# /remove-background/batch: max images per request and max total upload size, MB
MAX_BATCH_FILES=100
MAX_BATCH_MB=100

# ===== Model =====
# rembg model name; the file <U2NET_HOME>/<REMBG_MODEL>.onnx must exist
REMBG_MODEL=u2net_human_seg
# Folder with .onnx models. In Docker it is the /models/rembg volume.
U2NET_HOME=/models/rembg

# ===== Server (read by uvicorn and onnxruntime, not by the app) =====
# Path prefix behind nginx: Swagger opens at /rembg/docs. nginx must strip the prefix (see DEPLOY.md).
UVICORN_ROOT_PATH=/rembg
# onnxruntime threads per request; set to the number of CPU cores
OMP_NUM_THREADS=2
